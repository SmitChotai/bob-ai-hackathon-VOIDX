# Copy this file to .env and fill in your actual values
# NEVER commit the .env file — it is in .gitignore

# IBM watsonx.ai (optional — only needed if connecting a real LLM for the AI Copilot)
# VITE_WATSONX_API_KEY=your_api_key_here
# VITE_WATSONX_PROJECT_ID=your_project_id_here
# VITE_WATSONX_URL=https://us-south.ml.cloud.ibm.com

# Application
# VITE_APP_ENV=development

# NOTE: The MVP requires NO environment variables.
# All logistics data is simulated locally.
# The AI Copilot works fully without any API keys using the local rule-based engine.
